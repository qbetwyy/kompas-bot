# Токен нового бота от @BotFather (не от Физи!)
BOT_TOKEN=

# Ключ Anthropic API. Без него бот работает в резервном режиме (правила + база знаний).
ANTHROPIC_API_KEY=
# Нужно, только если check_keys.py попросит (ключ без рабочего пространства): id из Settings → Workspaces
# ANTHROPIC_WORKSPACE_ID=

# Модель: claude-sonnet-5-5 (качественнее) или claude-haiku-5-5 (дешевле и быстрее)
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT=60

# Прокси для Telegram Bot API, если api.telegram.org недоступен без VPN (например http://user:pass@host:port)
# TELEGRAM_PROXY=

# Голосовые сообщения: нужен пакет faster-whisper. Модель: tiny / base / small (small ≈ 1 ГБ RAM)
VOICE_ENABLED=true
WHISPER_MODEL=small

# Путь к базе SQLite (по умолчанию kompas.db рядом с bot.py)
# DB_PATH=/opt/kompas/kompas.db
